 /***********************************************************************
+ *           create_app_environment
+ *
+ * Meridian: HKCU\Software\Wine\AppDefaults\<app.exe>\Environment lists
+ * variables for that executable, set over the environment it would otherwise
+ * get. Steam starts every game with steam.exe's environment, so this is how
+ * one game gets its own settings (DXMT options). Names prefixed __CX_UNIX_
+ * also reach the Unix environment (CW Hack 24717 in ntdll).
+ * Returns a heap block, or NULL when the executable has no such key.
+ */
+static WCHAR *create_app_environment( const WCHAR *imagepath, const WCHAR *env )
+{
+    const WCHAR *name = wcsrchr( imagepath, '\\' );
+    WCHAR keyname[MAX_PATH + 64], valname[256], value[4096];
+    UNICODE_STRING nameW, valueW;
+    DWORD i, name_len, value_len, type;
+    WCHAR *ret = NULL;
+    LSTATUS status;
+    HKEY key;
+
+    name = name ? name + 1 : imagepath;
+    if (lstrlenW( name ) >= MAX_PATH) return NULL;
+    lstrcpyW( keyname, L"Software\\Wine\\AppDefaults\\" );
+    lstrcatW( keyname, name );
+    lstrcatW( keyname, L"\\Environment" );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, keyname, 0, KEY_QUERY_VALUE, &key )) return NULL;
+
+    if (env)
+    {
+        const WCHAR *p = env;
+        SIZE_T size;
+
+        while (*p) p += lstrlenW( p ) + 1;
+        size = (p - env + 1) * sizeof(WCHAR);
+        if ((ret = RtlAllocateHeap( GetProcessHeap(), 0, size ))) memcpy( ret, env, size );
+    }
+    else RtlCreateEnvironment( TRUE, &ret );
+
+    for (i = 0; ret; i++)
+    {
+        name_len = ARRAY_SIZE( valname );
+        value_len = sizeof(value) - sizeof(WCHAR);
+        status = RegEnumValueW( key, i, valname, &name_len, NULL, &type, (BYTE *)value, &value_len );
+        if (status == ERROR_NO_MORE_ITEMS) break;
+        if (status || type != REG_SZ) continue;
+        value[value_len / sizeof(WCHAR)] = 0;
+        RtlInitUnicodeString( &nameW, valname );
+        RtlInitUnicodeString( &valueW, value );
+        TRACE( "%s: %s=%s\n", debugstr_w(name), debugstr_w(valname), debugstr_w(value) );
+        RtlSetEnvironmentVariable( &ret, &nameW, &valueW );
+    }
+    RegCloseKey( key );
+    return ret;
+}
+
