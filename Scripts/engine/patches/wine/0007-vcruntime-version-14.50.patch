--- a/dlls/msvcp140_2/version.rc
+++ b/dlls/msvcp140_2/version.rc
@@ -18,6 +18,11 @@

 #define WINE_FILEDESCRIPTION_STR "Wine runtime library"
 #define WINE_FILENAME_STR "msvcp140_2.dll"
-#define WINE_FILEVERSION 14,42,34433,0
+/* Meridian: Wine 11.1's version (upstream 774a1f8a). Unreal 5.6+ games
+ * start through a bootstrapper that reads this file version and asks to
+ * install the Visual C++ redistributable below 14.50.35719. Installing it
+ * never helps: Wine maps this builtin even for version queries on
+ * Microsoft's file in system32. */
+#define WINE_FILEVERSION 14,50,35719,0

 #include "wine/wine_common_ver.rc"
