+    /* Meridian (HoldWindowsOffscreen): a held window's frame keeps its size
+       but sits past the bottom-left corner of every screen. */
+    - (NSRect) heldFrame:(NSRect)frame
+    {
+        NSRect screens = NSZeroRect;
 
+        if (!heldOffscreen) return frame;
+        for (NSScreen* screen in [NSScreen screens])
+            screens = NSUnionRect(screens, [screen frame]);
+        frame.origin.x = NSMinX(screens) - NSWidth(frame) - 1000;
+        frame.origin.y = NSMinY(screens) - NSHeight(frame) - 1000;
+        return frame;
+    }
+
