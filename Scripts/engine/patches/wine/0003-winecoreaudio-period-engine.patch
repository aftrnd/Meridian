+
+/* Render FIFO level the period timer keeps ahead of the device: one device
+ * pull, one period, and a quarter period for timer jitter. */
+static UINT32 render_target_frames(const struct coreaudio_stream *stream)
+{
+    UINT32 target = stream->dev_pull_frames + stream->period_frames + stream->period_frames / 4;
+    return min(target, stream->dev_bufsize_frames - stream->period_frames);
+}
+
+/* Appends frames to the render FIFO from src (NULL for silence). */
+static void render_fifo_append(struct coreaudio_stream *stream, const BYTE *src, UINT32 frames)
+{
+    UINT32 block = stream->fmt->nBlockAlign;
+    UINT32 tail = (stream->dev_offs_frames + stream->dev_held_frames) % stream->dev_bufsize_frames;
+    UINT32 chunk = min(frames, stream->dev_bufsize_frames - tail);
+
+    if(src){
+        memcpy(stream->dev_buffer + tail * block, src, chunk * block);
+        memcpy(stream->dev_buffer, src + chunk * block, (frames - chunk) * block);
+    }else{
+        silence_buffer(stream, stream->dev_buffer + tail * block, chunk);
+        silence_buffer(stream, stream->dev_buffer, frames - chunk);
+    }
+    stream->dev_held_frames += frames;
+}
+
+/* One period timer tick for a playing render stream: lead with silence when
+ * starting or after the device found the FIFO short (never otherwise, as that
+ * would be a gap of its own), then move exactly one period (or what the
+ * client has) out of the client buffer. */
+static void render_tick_nolock(struct coreaudio_stream *stream)
+{
+    UINT32 target = render_target_frames(stream), frames, chunk;
+
+    if(stream->flow != eRender || !stream->playing)
+        return;
+
+    if(stream->dev_starved){
+        if(stream->dev_underruns && stream->held_frames)
+            WARN("render FIFO ran dry while the client had data (%u times)\n", stream->dev_underruns);
+        if(stream->dev_held_frames < target)
+            render_fifo_append(stream, NULL, target - stream->dev_held_frames);
+        stream->dev_starved = FALSE;
+    }
+
+    frames = min(stream->held_frames, stream->period_frames);
+    frames = min(frames, stream->dev_bufsize_frames - stream->dev_held_frames);
+    chunk = min(frames, stream->bufsize_frames - stream->lcl_offs_frames);
+    render_fifo_append(stream, stream->local_buffer + stream->lcl_offs_frames * stream->fmt->nBlockAlign, chunk);
+    render_fifo_append(stream, stream->local_buffer, frames - chunk);
+    stream->lcl_offs_frames = (stream->lcl_offs_frames + frames) % stream->bufsize_frames;
+    stream->held_frames -= frames;
+
+    stream->dev_level_err += ((double)stream->dev_held_frames - target - stream->dev_level_err) / 32;
 }
 
