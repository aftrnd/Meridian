diff --git a/DepotDownloader/MeridianJson.cs b/DepotDownloader/MeridianJson.cs
new file mode 100644
index 0000000..a1646ba
--- /dev/null
+++ b/DepotDownloader/MeridianJson.cs
@@ -0,0 +1,91 @@
+// This file is subject to the terms and conditions defined
+// in file 'LICENSE', which is part of this source code package.
+
+// Meridian: machine-readable NDJSON event emitter on stdout. One compact JSON
+// object per line, consumed by Meridian's Swift side (DepotDownloaderInstall.swift
+// for installs; SteamAppInfoResolver for -appinfo). Kept dependency-free
+// (manual escaping, no System.Text.Json ceremony) so a single-file publish stays
+// tiny and the output is byte-stable.
+using System;
+
+namespace DepotDownloader
+{
+    internal static class MeridianJson
+    {
+        private static readonly object Gate = new();
+
+        private static string Escape(string s)
+        {
+            if (string.IsNullOrEmpty(s)) return "";
+            var sb = new System.Text.StringBuilder(s.Length + 8);
+            foreach (var c in s)
+            {
+                switch (c)
+                {
+                    case '"': sb.Append("\\\""); break;
+                    case '\\': sb.Append("\\\\"); break;
+                    case '\n': sb.Append("\\n"); break;
+                    case '\r': sb.Append("\\r"); break;
+                    case '\t': sb.Append("\\t"); break;
+                    default:
+                        if (c < 0x20) sb.Append("\\u").Append(((int)c).ToString("x4"));
+                        else sb.Append(c);
+                        break;
+                }
+            }
+            return sb.ToString();
+        }
+
+        private static void Emit(string line)
+        {
+            lock (Gate)
+            {
+                Console.Out.WriteLine(line);
+                Console.Out.Flush();
+            }
+        }
+
+        /// {"type":"phase","phase":"<p>","detail":"<d>"}
+        public static void Phase(string phase, string detail = null)
+        {
+            Emit($"{{\"type\":\"phase\",\"phase\":\"{Escape(phase)}\",\"detail\":\"{Escape(detail ?? "")}\"}}");
+        }
+
+        /// {"type":"progress","bytesDone":N,"bytesTotal":N,"pct":D}
+        public static void Progress(long bytesDone, long bytesTotal, double pct)
+        {
+            Emit($"{{\"type\":\"progress\",\"bytesDone\":{bytesDone},\"bytesTotal\":{bytesTotal},\"pct\":{pct.ToString(System.Globalization.CultureInfo.InvariantCulture)}}}");
+        }
+
+        /// {"type":"done","bytesDownloaded":N}
+        public static void Done(long bytesDownloaded)
+        {
+            Emit($"{{\"type\":\"done\",\"bytesDownloaded\":{bytesDownloaded}}}");
+        }
+
+        /// {"type":"error","message":"<m>"}
+        public static void Error(string message)
+        {
+            Emit($"{{\"type\":\"error\",\"message\":\"{Escape(message)}\"}}");
+        }
+
+        /// {"type":"appinfo","appid":N,"logo":"<hash>","capsule":"<hash>","hero":"<hash>",
+        ///  "logoPinned":"<BottomLeft|CenterCenter|…>","logoWidthPct":D,"logoHeightPct":D}
+        /// Empty string / 0 for any asset or position field the app does not publish.
+        /// logoWidthPct/logoHeightPct are Steam's intended logo box size as a
+        /// percentage of the hero; logoPinned is the anchor corner. Together they
+        /// reproduce Steam's own library logo placement.
+        public static void AppInfo(uint appid, string logo, string capsule, string hero,
+                                   string logoPinned, double logoWidthPct, double logoHeightPct)
+        {
+            var ci = System.Globalization.CultureInfo.InvariantCulture;
+            Emit($"{{\"type\":\"appinfo\",\"appid\":{appid}," +
+                 $"\"logo\":\"{Escape(logo ?? "")}\"," +
+                 $"\"capsule\":\"{Escape(capsule ?? "")}\"," +
+                 $"\"hero\":\"{Escape(hero ?? "")}\"," +
+                 $"\"logoPinned\":\"{Escape(logoPinned ?? "")}\"," +
+                 $"\"logoWidthPct\":{logoWidthPct.ToString(ci)}," +
+                 $"\"logoHeightPct\":{logoHeightPct.ToString(ci)}}}");
+        }
+    }
+}
