+        // Meridian: dump library art HASHES from PICS appinfo for the given apps.
+        //
+        // Steam's public IStoreBrowseService/GetItems API does NOT return the
+        // library LOGO for any game (only capsule/hero/header/icon), and the
+        // legacy /steam/apps/{id}/logo.png path 404s for newer titles. The logo
+        // lives ONLY in PICS appinfo at common.library_assets_full.library_logo.
+        // The `common` section is available to an ANONYMOUS logon, so this needs
+        // no license — Meridian calls it anonymously (or with the user's token).
+        //
+        // Emits one NDJSON `appinfo` line per app:
+        //   {"type":"appinfo","appid":N,"logo":"<hash>","capsule":"<hash>","hero":"<hash>"}
+        // where <hash> is the 40-hex content directory (the segment before the
+        // filename, e.g. "4037b4ea.../logo.png" → "4037b4ea..."). Empty when the
+        // app does not publish that asset.
+        public static async Task DumpAppInfoAsync(uint[] appIds)
+        {
+            // Extracts the leading content-hash directory from an appinfo asset
+            // value like "4037b4ea74455653c6c369d098fbb26dd54c988b/logo_2x.png".
+            static string HashOf(KeyValue node)
+            {
+                // New-CDN values are "<40-hex>/<filename>"; the leading directory
+                // is the content hash. OLDER titles store a BARE filename
+                // ("logo.png") served from the legacy /steam/apps/{id}/ path with
+                // NO content hash — for those return "" so the Swift side keeps
+                // its working legacy-CDN fallback instead of building a broken
+                // new-CDN URL from the filename. (The logo_position still applies
+                // to whichever logo source is used.)
+                var v = node?.Value;
+                if (string.IsNullOrEmpty(v)) return "";
+                var slash = v.IndexOf('/');
+                if (slash <= 0) return "";
+                var head = v.Substring(0, slash);
+                bool looksLikeHash = head.Length == 40 &&
+                    head.All(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'));
+                return looksLikeHash ? head : "";
+            }
+
+            // library_assets_full.<asset>.image.english (fall back to image2x,
+            // then any first child language if english is absent).
+            static string AssetHash(KeyValue full, string assetName)
+            {
+                if (full == KeyValue.Invalid || full == null) return "";
+                var asset = full[assetName];
+                if (asset == KeyValue.Invalid) return "";
+                foreach (var imgKey in new[] { "image", "image2x" })
+                {
+                    var img = asset[imgKey];
+                    if (img == KeyValue.Invalid) continue;
+                    var en = img["english"];
+                    if (en != KeyValue.Invalid && !string.IsNullOrEmpty(en.Value)) return HashOf(en);
+                    var first = img.Children.FirstOrDefault();
+                    if (first != null && !string.IsNullOrEmpty(first.Value)) return HashOf(first);
+                }
+                return "";
+            }
+
+            foreach (var appId in appIds)
+            {
+                try
+                {
+                    await steam3.RequestAppInfo(appId).ConfigureAwait(false);
+                }
+                catch (Exception ex)
+                {
+                    Console.Error.WriteLine($"appinfo request failed for {appId}: {ex.Message}");
+                    MeridianJson.AppInfo(appId, "", "", "", "", 0, 0);
+                    continue;
+                }
+
+                var common = GetSteam3AppSection(appId, EAppInfoSection.Common);
+                var full = common?["library_assets_full"] ?? KeyValue.Invalid;
+
+                var logo = AssetHash(full, "library_logo");
+                var capsule = AssetHash(full, "library_capsule");
+                var hero = AssetHash(full, "library_hero");
+
+                // Steam's intended logo placement on the hero:
+                // library_assets_full.library_logo.logo_position = { pinned_position,
+                // width_pct, height_pct }. Reproduces Steam's own library layout.
+                static double Pct(KeyValue node)
+                {
+                    var v = node?.Value;
+                    return double.TryParse(v, System.Globalization.NumberStyles.Float,
+                        System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0.0;
+                }
+                var pinned = "";
+                double widthPct = 0, heightPct = 0;
+                if (full != KeyValue.Invalid && full != null)
+                {
+                    var pos = full["library_logo"]["logo_position"];
+                    if (pos != KeyValue.Invalid)
+                    {
+                        pinned = pos["pinned_position"].Value ?? "";
+                        widthPct = Pct(pos["width_pct"]);
+                        heightPct = Pct(pos["height_pct"]);
+                    }
+                }
+
+                MeridianJson.AppInfo(appId, logo, capsule, hero, pinned, widthPct, heightPct);
+            }
+        }
